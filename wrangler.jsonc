{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saaslaunchlab",
  "main": "worker.js",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
